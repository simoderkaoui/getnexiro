# ==============================================================================
# getNexiro Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Never commit your real .env file with production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-replace-with-a-random-secure-secret-key-in-production
DEBUG=False

# ------------------------------------------------------------------------------
# Email SMTP Configuration (Contact Form Dispatcher)
# ------------------------------------------------------------------------------
# In local development without credentials, emails are safely printed to the console.
# To send live emails in production or staging, configure SMTP below:

# Choose backend: 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Option A: Gmail SMTP (Recommended for getnexiro@gmail.com) ---
# NOTE: To use Gmail, you must:
# 1. Enable 2-Step Verification on your Google Account (getnexiro@gmail.com).
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an "App Password" (e.g. named "getNexiro Website").
# 4. Paste the 16-character password below (without spaces).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=getnexiro@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
DEFAULT_FROM_EMAIL=getNexiro <getnexiro@gmail.com>
SERVER_EMAIL=getNexiro <getnexiro@gmail.com>
EMAIL_TIMEOUT=10

# --- Option B: Custom Domain SMTP (e.g., hello@getnexiro.com) ---
# EMAIL_HOST=mail.getnexiro.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=hello@getnexiro.com
# EMAIL_HOST_PASSWORD=your-mailbox-password
# DEFAULT_FROM_EMAIL=getNexiro <hello@getnexiro.com>
# SERVER_EMAIL=getNexiro <hello@getnexiro.com>

# --- Option C: SendGrid / Brevo / Mailgun ---
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=getNexiro <contact@getnexiro.com>

# ------------------------------------------------------------------------------
# ANTI-SPAM & EMAIL DELIVERABILITY BEST PRACTICES
# ------------------------------------------------------------------------------
# To guarantee 100% inbox delivery and avoid the Spam / Junk folder:
# 1. MATCH FROM & HOST: The DEFAULT_FROM_EMAIL address must match your authenticated
#    SMTP user (e.g., if sending through Gmail, use getnexiro@gmail.com).
# 2. IF USING A CUSTOM DOMAIN (getnexiro.com), add these DNS TXT records:
#    - SPF Record:   v=spf1 include:_spf.google.com ~all
#    - DMARC Record: v=DMARC1; p=quarantine; rua=mailto:dmarc@getnexiro.com
#    - DKIM Record:  Generated by your mail provider (Google Workspace, SendGrid, etc.)
# 3. The contact system already includes:
#    - Dual text/plain and text/html alternative MIME parts.
#    - RFC Auto-Submitted headers to prevent automated bounce loops.
#    - Physical Tangier postal address in the email footer.
#    - Reply-To headers for 1-click replies to the sender.
