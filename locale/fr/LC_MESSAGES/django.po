# SERVICES PAGE
# ═══════════════════════════════════════════

msgid "Our Services"
msgstr "Nos services"

msgid "End-to-End"
msgstr "De bout en bout"

msgid "Digital Solutions"
msgstr "Solutions numériques"

msgid "From concept to deployment and beyond — we cover every aspect of your digital product lifecycle."
msgstr "Du concept au déploiement et au-delà — nous couvrons chaque aspect du cycle de vie de votre produit numérique."

msgid "Mobile Applications"
msgstr "Applications mobiles"

msgid "From responsive marketing sites to complex SaaS platforms, we architect and build robust web solutions using Django, React, and modern frameworks."
msgstr "Des sites marketing responsives aux plateformes SaaS complexes, nous architecturons et construisons des solutions web robustes utilisant Django, React et des frameworks modernes."

msgid "Native iOS/Android and cross-platform apps built with Flutter and React Native, delivering seamless performance and beautiful interfaces."
msgstr "Applications natives iOS/Android et multiplateformes construites avec Flutter et React Native, offrant des performances fluides et de belles interfaces."

msgid "User research, wireframing, prototyping, and pixel-perfect design systems that elevate your brand and convert visitors into customers."
msgstr "Recherche utilisateur, wireframing, prototypage et systèmes de design pixel-perfect qui élèvent votre marque et convertissent les visiteurs en clients."

msgid "Technical Consulting"
msgstr "Conseil technique"

msgid "Architecture reviews, technology audits, and strategic roadmapping to ensure your digital investments deliver maximum ROI."
msgstr "Revues d'architecture, audits technologiques et feuilles de route stratégiques pour garantir que vos investissements numériques livrent un ROI maximal."

msgid "API & Integration"
msgstr "API & Intégration"

msgid "RESTful and GraphQL APIs, third-party integrations, and microservices architecture designed for scalability and reliability."
msgstr "APIs RESTful et GraphQL, intégrations tierces et architecture microservices conçues pour l'évolutivité et la fiabilité."

msgid "Cloud & DevOps"
msgstr "Cloud & DevOps"

msgid "Cloud infrastructure, CI/CD pipelines, containerization, and monitoring — we ensure your applications run flawlessly at any scale."
msgstr "Infrastructure cloud, pipelines CI/CD, conteneurisation et monitoring — nous garantissons que vos applications fonctionnent parfaitement à toute échelle."

msgid "Discuss this service"
msgstr "Discuter de ce service"

msgid "Our Process"
msgstr "Notre processus"

msgid "How We Work"
msgstr "Comment nous travaillons"

msgid "Discovery"
msgstr "Découverte"

msgid "Deep dive into your business, users, and technical requirements."
msgstr "Plongée approfondie dans votre entreprise, vos utilisateurs et vos exigences techniques."

msgid "Design"
msgstr "Conception"

msgid "Architecture planning, wireframes, and high-fidelity prototypes."
msgstr "Planification d'architecture, wireframes et prototypes haute fidélité."

msgid "Develop"
msgstr "Développement"

msgid "Agile sprints with transparent progress tracking and quality assurance."
msgstr "Sprints agiles avec suivi transparent de l'avancement et assurance qualité."

msgid "Deploy & Support"
msgstr "Déploiement & Support"

msgid "Seamless launch and ongoing maintenance for continuous improvement."
msgstr "Lancement fluide et maintenance continue pour une amélioration permanente."

msgid "Have a Project in Mind?"
msgstr "Vous avez un projet en tête ?"

msgid "Tell us about your vision and let's explore how we can bring it to life."
msgstr "Parlez-nous de votre vision et explorons comment nous pouvons la concrétiser."

msgid "Start a Conversation"
msgstr "Entamer une conversation"

